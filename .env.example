# ---- Modo: backtest | paper | live ----
BOT_MODE=paper

# ---- Capital operativo (ARS) ----
BOT_CAPITAL_ARS=1000000

# ---- InvertirOnline (API v2) ----
BOT_IOL_USERNAME=
BOT_IOL_PASSWORD=
BOT_IOL_BASE_URL=https://api.invertironline.com

# ---- Primary / Matba Rofex (Matriz) ----
BOT_PRIMARY_USERNAME=
BOT_PRIMARY_PASSWORD=
BOT_PRIMARY_ACCOUNT=
BOT_PRIMARY_BASE_URL=https://api.primary.com.ar
BOT_PRIMARY_WS_URL=wss://api.primary.com.ar/
# Futuro de dolar a operar (ej. DLR/DIC26) y su vencimiento
BOT_FUTURE_SYMBOL=DLR/DIC26
BOT_FUTURE_EXPIRY=2026-12-30

# ---- Broker tier de comisiones: standard | gold | vip ----
BOT_FEE_TIER=gold

# ---- Tasas de referencia (TNA, fraccion: 0.30 = 30%) usadas si la API no las provee ----
BOT_CAUCION_COLOCADORA_TNA=0.28
BOT_CAUCION_TOMADORA_TNA=0.34

# ---- Telegram (solo alertas; opcional) ----
BOT_TELEGRAM_TOKEN=
BOT_TELEGRAM_CHAT_ID=

# ---- Persistencia ----
BOT_DB_PATH=data/bot.db
