# Copiar a .env. Nunca commitear .env.
# Para paper: usar claves de TESTNET (p. ej. https://testnet.binance.vision). Para live: claves con
# permiso de trading y SIN permiso de retiro, con whitelist de IP.
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
# Obligatorio para mode: live. Cualquier otro valor bloquea el modo live.
TRADEBOT_LIVE_CONFIRM=NO
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
